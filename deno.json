{
  "tasks": {
    "deploy": "fly deploy",
    "status": "fly status",
    "start": {
      "description": "Run Lume command",
      "command": "deno run -P=lume lume/cli.ts"
    },
    "build": {
      "description": "Build the site for production",
      "command": "deno task start"
    },
    "dev": {
      "description": "Run and serve the site for development",
      "command": "deno task start -s"
    }
  },
  "imports": {
    "@/": "./lib/",
    "@/includes/": "./site/_includes/",
    "@googleapis/drive": "npm:@googleapis/drive",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/collections": "jsr:@std/collections",
    "rehype-pretty-code": "npm:rehype-pretty-code@^0.14.3",
    "rehype-stringify": "npm:rehype-stringify",
    "remark-parse": "npm:remark-parse",
    "remark-rehype": "npm:remark-rehype",
    "remark-frontmatter": "npm:remark-frontmatter",
    "remark-gfm": "npm:remark-gfm",
    "shiki": "npm:shiki@^4.3.0",
    "unified": "npm:unified",
    "vfile-matter": "npm:vfile-matter",
    "@shikijs/rehype": "npm:@shikijs/rehype@^4.3.0",
    "remark-obsidian": "npm:remark-obsidian",
    "slugify": "npm:slugify",
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.1.4/",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.14/jsx-runtime.ts"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "lume",
    "noImplicitOverride": false,
    "types": ["lume/types.ts"]
  },
  "fmt": {
    "semiColons": false,
    "include": ["lib/", "/tasks", "/web"]
  },
  "permissions": {
    "lume": {
      "read": true,
      "write": ["./"],
      "import": [
        "cdn.jsdelivr.net:443",
        "jsr.io:443",
        "deno.land:443",
        "esm.sh:443"
      ],
      "net": [
        "0.0.0.0",
        "cdn.jsdelivr.net:443",
        "data.jsdelivr.com:443",
        "jsr.io:443",
        "deno.land:443",
        "esm.sh:443",
        "registry.npmjs.org:443"
      ],
      "env": true,
      "run": true,
      "ffi": true,
      "sys": true
    }
  },
  "lint": {
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@3.1.4/lint.ts"
    ],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "lock": false
}
