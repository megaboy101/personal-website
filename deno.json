{
  "tasks": {
    "dev": "deno run -A --watch blog.ts",
    "start": "deno run -A blog.ts",
    "deploy": "fly deploy",
    "status": "fly status",
    "lume": {
      "description": "Run Lume command",
      "command": "deno run -P=lume lume/cli.ts"
    },
    "build": {
      "description": "Build the site for production",
      "command": "deno task lume"
    },
    "serve": {
      "description": "Run and serve the site for development",
      "command": "deno task lume -s"
    }
  },
  "imports": {
    "@/": "./lib/",
    "@/includes/": "./site/_includes/",
    "@std/assert": "jsr:@std/assert@~1",
    "@std/testing": "jsr:@std/testing@^1.0.9",
    "@googleapis/drive": "npm:@googleapis/drive",
    "gcp-metadata": "npm:gcp-metadata@6.1.0",
    "zod": "npm:zod@~3.24.1",
    "hono": "jsr:@hono/hono@~4.6.0",
    "@std/dotenv": "jsr:@std/dotenv@~0.224.0",
    "@std/path": "jsr:@std/path",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/collections": "jsr:@std/collections",
    "isbot": "npm:isbot",
    "@db/sqlite": "jsr:@db/sqlite@^0.12.0",
    "@notionhq/client": "npm:@notionhq/client",
    "notion-to-md": "npm:notion-to-md",
    "markdown-it": "npm:markdown-it",
    "highlight.js": "npm:highlight.js",
    "rehype-sanitize": "npm:rehype-sanitize",
    "rehype-stringify": "npm:rehype-stringify",
    "remark-parse": "npm:remark-parse",
    "remark-rehype": "npm:remark-rehype",
    "remark-frontmatter": "npm:remark-frontmatter",
    "remark-gfm": "npm:remark-gfm",
    "unified": "npm:unified",
    "vfile-matter": "npm:vfile-matter",
    "@shikijs/rehype": "npm:@shikijs/rehype",
    "remark-obsidian": "npm:remark-obsidian",
    "slugify": "npm:slugify",
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.1.4/",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.14/jsx-runtime.ts"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "lume",
    "noImplicitOverride": false,
    "types": ["lume/types.ts"]
  },
  "unstable": ["cron", "temporal", "fmt-component"],
  "fmt": {
    "semiColons": false,
    "include": ["lib/", "/tasks", "/web"]
  },
  "permissions": {
    "lume": {
      "read": true,
      "write": ["./"],
      "import": [
        "cdn.jsdelivr.net:443",
        "jsr.io:443",
        "deno.land:443",
        "esm.sh:443"
      ],
      "net": [
        "0.0.0.0",
        "cdn.jsdelivr.net:443",
        "data.jsdelivr.com:443",
        "jsr.io:443",
        "deno.land:443",
        "esm.sh:443",
        "registry.npmjs.org:443"
      ],
      "env": true,
      "run": true,
      "ffi": true,
      "sys": true
    }
  },
  "lint": {
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@3.1.4/lint.ts"
    ],
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  },
  "lock": false
}
